momentosbs <- function(nu, m) {
  if (m == 1) {
    result = 0.5 * (2 + nu^2)
  } else if (m == 2) {
    result = 0.5 * (2 + 4 * nu^2 + 3 * nu^4)
  } else if (m == 3) {
    result = 0.5 * (2 + 9 * nu^2 + 18 * nu^4 + 15 * nu^6)
  } else if (m == 4) {
    result = 0.5 * (2 + 16 * nu^2 + 60 * nu^4 + 120 * nu^6 + 105 * nu^8)
  } else {
    result = NA
    warning("m until 4th moment")
  }
  return(result)
}
momentost<-function(nu,k){
  result=(gamma((nu-(2*k))/2))/(gamma(nu/2))*(nu/2)^k
  return(result)
  
}
momentost(6,4)
kurtosisbst<-function(alpha,nu,dist){
  if(dist=="BSt"){
    a4=840*momentosbs(nu,4)-240*momentosbs(nu,1)*momentosbs(nu,3)+
      36*((momentosbs(nu,1))^2)*momentosbs(nu,2)-3*((momentosbs(nu,1))^4)
    
    kurto=(48*momentosbs(nu,2)+(480*momentosbs(nu,3)-144*momentosbs(nu,1)*momentosbs(nu,2)+
                                   24*(momentosbs(nu,1)^3))*(alpha^2)+a4*(alpha^4))/((4*momentosbs(nu,1)+
                                                                                     (6*momentosbs(nu,2)-(momentosbs(nu,1)^2))*(alpha^2))^2)
      
  }
  if(dist=="Student"){
    a4=840*momentost(nu,4)-240*momentost(nu,1)*momentost(nu,3)+
      36*((momentost(nu,1))^2)*momentost(nu,2)-3*((momentost(nu,1))^4)
    kurto=(48*momentost(nu,2)+(480*momentost(nu,3)-144*momentost(nu,1)*momentost(nu,2)+
                                 24*(momentost(nu,1)^3))*alpha^2+a4*(alpha^4))/(4*momentost(nu,1)+
                                                                                  (6*momentost(nu,2)-(momentost(nu,1)^2))*(alpha^2))^2
  }
  if(dist=="Normal"){
    kurto=(48+360*alpha^2+633*alpha^4)/(4+5*alpha^2)^2
  }
return(kurto)
  }
kurtosismnbs<-function(p,nu,dist){
  if(dist=="bs"){
  result=2*p*(p+2)*(2+4*nu^2+3*nu^4)/(4+4*nu^2+nu^4)}
  if(dist=="St"){
    result=p*(p+2)*(nu-2)/(nu-4)  
  }
  if(dist=="Normal"){result=p*(p+2)}
  return(result)
}

