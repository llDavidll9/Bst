veroenvel<-function(t,alpha,beta,Sigma,nu){
  
  mm=dim(t)[1]
  p=dim(t)[2]
  
  
  epsilon=matrix(0,mm,p)
  at=matrix(0,mm,p)
  Atparte=matrix(0,mm,p)
  vero1=matrix(0,mm,1)
  
  
  
  for (j in 1:p) {
    epsilon[,j]=sqrt(t[,j]/beta[j])-sqrt(beta[j]/t[,j])
    at[,j]=epsilon[,j]/alpha[j]
    Atparte[,j]= (t[,j]+beta[j])/(2*alpha[j]*sqrt(beta[j])*sqrt(t[,j]^3))
  }   
  At=apply(Atparte,1,prod)
  
  lambda1=(-p+1)/2
  lambda2=(-p-1)/2
  a1=(2*pi)^(-p/2)*(nu^((p-1)/2)*besselK(nu^(-2),1/2))^(-1)
  a2=(2*pi)^(-p/2)*(nu^((p+1)/2)*besselK(nu^(-2),-1/2))^(-1)
  
  for (d in 1:mm){
    dt1=as.numeric(at[d,]%*%solve(Sigma)%*%t(t(at[d,])))
    qt=sqrt(nu^(-2)+dt1)
    omega=nu^(-1)*qt	
    f1=a1*qt^lambda1*besselK(omega,lambda1)
    f2=a2*qt^lambda2*besselK(omega,lambda2)
    funk=f1+f2
    
    vero1[d]=-0.5*log(det(Sigma))+log(At[d])+log(0.5*funk)
    
  }
  
  #vero=sum(vero1)
  return(vero1)
}
veroheltonenvel<-function(t,alpha,beta,Sigma,nu,dist){
  
  mm=dim(t)[1]
  p=dim(t)[2]
  
  eta=matrix(0,mm,p)
  epsilon=matrix(0,mm,p)
  at=matrix(0,mm,p)
  Atparte=matrix(0,mm,p)
  vero1=matrix(0,mm,1)
  dt=matrix(0,mm,1)
  funk=matrix(0,mm,1)
  
  
  for (j in 1:p) {
    epsilon[,j]=sqrt(t[,j]/beta[j])-sqrt(beta[j]/t[,j])
    at[,j]=epsilon[,j]/alpha[j]
    Atparte[,j]= (t[,j]+beta[j])/(2*alpha[j]*sqrt(beta[j])*sqrt(t[,j]^3))
  }   
  At=apply(Atparte,1,prod)
  
  
  
  
  for (d in 1:mm){
    dt[d]=as.numeric(at[d,]%*%solve(Sigma)%*%t(t(at[d,])))    
    if (dist == "Normal"){#funk[d]=dnorm(sqrt(dt[d]))  
      funk[d]=dmvnorm(t(at[d,]), mean = rep(0, p) , sigma =Sigma)} 
    if (dist == "Student"){funk[d]=(pi^(-p/2)*nu^(nu/2)*gamma((nu+p)/2))/(gamma(nu/2)*(dt[d]+nu)^((nu+p)/2))}
    if (dist == "Slash"){funk[d]=(2*pi)^(-p/2)*(  (nu*2^(nu+(p/2))*gamma( nu+(p/2) )  )/dt[d]^(nu+(p/2)) )*fp1(a=nu+(p/2),b=dt[d]/2)}
    if (dist == "Cont"){nu1=nu[1]
    gama=nu[2]
    #funk[d]=(nu1*dnorm(sqrt(dt[d]),0,(1/sqrt(gama)))+(1-nu1)*dnorm(sqrt(dt[d])))
    funk[d]=nu1*dmvnorm(t(at[d,]), mean = rep(0, p) , sigma =(gama^(-1))*Sigma)+(1-nu1)*dmvnorm(t(at[d,]), mean = rep(0, p) , sigma =Sigma)}
    if(p>1){
      vero1[d]=-0.5*log(det(Sigma))+log(At[d])+log(funk[d])
      if ((dist == "Normal")|| (dist == "Cont")){
        vero1[d]=log(At[d])+log(funk[d])
      }
      
    }else{vero1[d]=log(At[d])+log(funk[d])}
    
  }
  
  
  return(vero1)
}


envelopes<-function(t,alpha,beta,Sigma,nu,dist){
  if(dist=="Bst"){
    u=veroenvel(t,alpha,beta,Sigma,nu)
  }
  if(dist=="Normal"){
    u=veroheltonenvel(t,alpha,beta,Sigma,nu,"Normal")
  }
  if(dist=="Student"){
    u=veroheltonenvel(t,alpha,beta,Sigma,nu,"Student")
  }
  if(dist=="Slash"){
    u=veroheltonenvel(t,alpha,beta,Sigma,nu,"Slash")
  }
  if(dist=="Cont"){
    u=veroheltonenvel(t,alpha,beta,Sigma,nu,"Cont")
  }
  empiricau=ecdf(u)
  plot(empiricau,u,xlab="Log density",ylab="ECDF",main="")
  
  n=dim(t)[1]
  p=dim(t)[2]
  
  for(i in 1:500){
    
    
    if(dist=="Bst"){
      source("programas.txt")
      tnovo=gera(n,p,alpha,beta,Sigma,nu)
      v=veroenvel(tnovo,alpha,beta,Sigma,nu)
    }
    if(dist=="Normal"){
      source("programas_renata_helton_david.txt")
      tnovo=gerahelton(n,p,alpha,beta,Sigma,nu,"Normal")
      v=veroheltonenvel(tnovo,alpha,beta,Sigma,nu,"Normal")
    }
    if(dist=="Student"){
      source("programas_renata_helton_david.txt")
      tnovo=gerahelton(n,p,alpha,beta,Sigma,nu,"Student")
      v=veroheltonenvel(tnovo,alpha,beta,Sigma,nu,"Student")
    }
    if(dist=="Slash"){
      source("programas_renata_helton_david.txt")
      tnovo=gerahelton(n,p,alpha,beta,Sigma,nu,"Slash")
      v=veroheltonenvel(tnovo,alpha,beta,Sigma,nu,"Slash")
    }
    if(dist=="Cont"){
      source("programas_renata_helton_david.txt")
      tnovo=gerahelton(n,p,alpha,beta,Sigma,nu,"Cont")
      v=veroheltonenvel(tnovo,alpha,beta,Sigma,nu,"Cont")
    }
    empiricav=ecdf(v)
    par(new=TRUE)
    plot(empiricav,v,xlab="",ylab="",main="",col="lightgray",axes=F)
    print(i)
  }
  par(new=TRUE)
  plot(empiricau,u,xlab="",ylab="",main="",axes=F)
  
}
